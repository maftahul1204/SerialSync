PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/serialsync
JWT_SECRET=change-me-in-production
CLIENT_URL=http://localhost:3000
REDIS_URL=
REPORT_HMAC_SECRET=change-me-report-hmac
NODE_ENV=development
# SMS gateway: console (log only) or http (needs SMS_API_URL / SMS_API_KEY)
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=SerialSync
# Set true when running behind a reverse proxy / load balancer
TRUST_PROXY=false
